# Database connection string (from Supabase, Neon, or local PostgreSQL)
# Example Supabase: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Example Neon: postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/parksmart

# JWT secret — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# Port for the Express server
PORT=3001

# Node environment
NODE_ENV=development
