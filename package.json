{
  "name": "parksmart",
  "version": "1.0.0",
  "description": "Smart Parking Management System",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm.cmd --prefix client run dev",
    "dev": "npm.cmd run dev:server & npm.cmd run dev:client",
    "start": "node server/index.js",
    "setup-db": "node server/db/setup.js",
    "migrate": "node server/db/migrate.js",
